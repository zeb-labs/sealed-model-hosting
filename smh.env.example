# Settings for smh.sh. Copy this file to smh.env and fill it in. smh.env is not committed.

# REQUIRED for the watcher agent (the AI that looks into a failed step, fixes what is safe and tells you the rest).
# An Amazon Bedrock inference profile ID or ARN for a Claude model that your account may use, for example
#   global.anthropic.claude-opus-4-6-v1      or      arn:aws:bedrock:us-east-1:<account>:application-inference-profile/<id>
# Nothing is created for it. Without it the watcher still works, with plain rules instead of the AI model.
SMH_AGENT_MODEL=REPLACE_WITH_YOUR_BEDROCK_INFERENCE_PROFILE
export SMH_AGENT_MODEL

# OPTIONAL. Only for an AWS account that cannot have one more network (VPC): build the customer's stack inside an
# existing network that already has a KMS endpoint. Leave these out to let the stack create its own network.
# OC_EXTRA="ExistingVpcId=vpc-REPLACE ExistingKmsEndpointSg=sg-REPLACE Cidr=10.211.0.64/26"
# OC_CIDR=10.211.0.64/26
# export OC_EXTRA OC_CIDR
