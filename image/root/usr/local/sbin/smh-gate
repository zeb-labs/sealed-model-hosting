#!/bin/bash
# Before the front gate starts: make this boot's TLS certificate and an empty
# key list. The private key lives in RAM only (/run) and never leaves the
# machine. The certificate's fingerprint goes to the console and so to the
# customer's log, where the customer can read it and pin it.
set -euo pipefail
D=/run/smh-gate; install -d -m 0750 -g nginx "$D"
TOK=$(curl -s -m 3 -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')
IP=$(curl -s -m 3 -H "X-aws-ec2-metadata-token: $TOK" http://169.254.169.254/latest/meta-data/local-ipv4)
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 365 \
    -keyout "$D/gate.key" -out "$D/gate.crt" -subj "/CN=smh-sealed-machine" -addext "subjectAltName=IP:$IP" 2>/dev/null
chmod 0600 "$D/gate.key"; : > "$D/keys.map"; chgrp nginx "$D/keys.map"; chmod 0640 "$D/keys.map"
echo "SMH GATE https on $IP:443 cert_sha256=$(openssl x509 -in "$D/gate.crt" -noout -fingerprint -sha256 | cut -d= -f2 | tr -d :)"
